@startuml Sequence_Annulation_Paiement
!theme plain
autonumber
actor "Client" as Client
participant "API Gateway\n:8080" as Gateway
participant "Reservation Service\n:8083" as ResSrv
participant "Payment Service\n:8084" as PaySrv
participant "Vehicle Service\n:8082" as VehicleSrv
queue "RabbitMQ\nBroker" as Broker

title Scénario d'Annulation de Réservation et Remboursement

Client -> Gateway : PUT /api/reservations/101/cancel (JWT)
Gateway -> ResSrv : PUT /api/reservations/101/cancel

note over ResSrv : Vérification des conditions d'annulation\n(> 48h avant début -> Remboursement intégral)
ResSrv -> ResSrv : Mise à jour statut Réservation -> CANCELLED

group Appel Synchrone Remboursement (OpenFeign)
    ResSrv -> PaySrv : POST /api/payments/refund/reservation/101
    note over PaySrv : Traitement du remboursement\nMise à jour statut -> REFUNDED
    PaySrv --> ResSrv : 200 OK {paymentStatus: "REFUNDED", amountRefunded: 225.00}
end

== Événement Asynchrone de Libération ==
ResSrv -> Broker : Publication événement "reservation.cancelled"\n{reservationId: 101, vehicleId: 5}

Broker -> VehicleSrv : Consommation "reservation.cancelled"
note over VehicleSrv : Remise en disponibilité du véhicule #5 -> AVAILABLE

ResSrv --> Gateway : 200 OK {reservationId: 101, status: "CANCELLED", refundStatus: "PROCESSED"}
Gateway --> Client : 200 OK (Notification d'annulation et avis de remboursement)

@enduml
