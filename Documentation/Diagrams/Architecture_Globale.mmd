graph TB
    subgraph CLIENT["Poste Client & Navigateur"]
        ANGULAR["Frontend Angular 17+<br/>SPA (Single Page Application)<br/>Port 4200"]
    end

    subgraph COMMON["Microservice Commun & Infrastructure"]
        GATEWAY["API Gateway<br/>Spring Cloud Gateway<br/>Port 8080<br/>Routage, Filtre JWT, CORS, Rate Limiting"]
        EUREKA["Service Discovery<br/>Netflix Eureka Server<br/>Port 8761<br/>Enregistrement & Découverte"]
        RABBITMQ["Message Broker<br/>RabbitMQ (AMQP)<br/>Port 5672 / 15672<br/>Événements Asynchrones"]
    end

    subgraph CORE_SERVICES["Microservices Métier (Spring Boot 3.2+)"]
        USER_SRV["1. User Service<br/>Port 8081<br/>Auth, JWT, Profils, Rôles"]
        VEHICLE_SRV["2. Vehicle Service<br/>Port 8082<br/>Flotte, Disponibilités, Filtres"]
        RES_SRV["3. Reservation Service<br/>Port 8083<br/>Réservations, Calcul Prix, Statuts"]
        PAY_SRV["4. Payment Service<br/>Port 8084<br/>Paiements, Facturation, Statuts"]
        AGENCY_SRV["5. Agency Service<br/>Port 8085<br/>Agences, Adresses, Employés"]
        REVIEW_SRV["6. Review Service<br/>Port 8086<br/>Notes, Avis, Évaluations"]
    end

    subgraph DATABASES["Bases de Données Découplées (Database-per-Service)"]
        DB_USER[("PostgreSQL<br/>user_db:5432")]
        DB_VEHICLE[("PostgreSQL<br/>vehicle_db:5433")]
        DB_RES[("PostgreSQL<br/>reservation_db:5434")]
        DB_PAY[("PostgreSQL<br/>payment_db:5435")]
        DB_AGENCY[("PostgreSQL<br/>agency_db:5436")]
        DB_REVIEW[("MongoDB<br/>review_db:27017")]
    end

    ANGULAR -->|HTTP / HTTPS REST| GATEWAY
    GATEWAY -->|Routage dynamique| EUREKA
    EUREKA -.->|Heartbeat / Registry| USER_SRV
    EUREKA -.->|Heartbeat / Registry| VEHICLE_SRV
    EUREKA -.->|Heartbeat / Registry| RES_SRV
    EUREKA -.->|Heartbeat / Registry| PAY_SRV
    EUREKA -.->|Heartbeat / Registry| AGENCY_SRV
    EUREKA -.->|Heartbeat / Registry| REVIEW_SRV

    GATEWAY -->|/api/users/**| USER_SRV
    GATEWAY -->|/api/vehicles/**| VEHICLE_SRV
    GATEWAY -->|/api/reservations/**| RES_SRV
    GATEWAY -->|/api/payments/**| PAY_SRV
    GATEWAY -->|/api/agencies/**| AGENCY_SRV
    GATEWAY -->|/api/reviews/**| REVIEW_SRV

    %% Communications synchrones Feign
    RES_SRV -->|OpenFeign (Synchrone)<br/>Vérifier disponibilité| VEHICLE_SRV
    RES_SRV -->|OpenFeign (Synchrone)<br/>Créer transaction| PAY_SRV
    VEHICLE_SRV -->|OpenFeign (Synchrone)<br/>Vérifier agence| AGENCY_SRV

    %% Communications asynchrones RabbitMQ
    RES_SRV -.->|Publie reservation.created / cancelled| RABBITMQ
    PAY_SRV -.->|Publie payment.completed / failed| RABBITMQ
    RABBITMQ -.->|Consomme pour mise à jour statut| RES_SRV
    RABBITMQ -.->|Consomme pour màj disponibilité| VEHICLE_SRV

    %% Bases de données
    USER_SRV --- DB_USER
    VEHICLE_SRV --- DB_VEHICLE
    RES_SRV --- DB_RES
    PAY_SRV --- DB_PAY
    AGENCY_SRV --- DB_AGENCY
    REVIEW_SRV --- DB_REVIEW
