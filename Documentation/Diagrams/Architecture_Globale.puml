@startuml Architecture_Globale_CarRental
!theme plain
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam shadowing false

title Architecture Microservices Globale - CarRental AWD

actor "Client / Admin / Employé" as user
node "Navigateur Web" {
    component [Frontend Angular 17+\n(Port: 4200)] as Frontend
}

package "Infrastructure Commune" {
    component [API Gateway\n(Spring Cloud Gateway)\nPort: 8080] as Gateway
    component [Discovery Server\n(Netflix Eureka)\nPort: 8761] as Eureka
    queue [Message Broker\n(RabbitMQ AMQP)\nPort: 5672] as RabbitMQ
}

package "Microservices Métier (Spring Boot 3.2)" {
    component [User Service\n(Port: 8081)] as UserService
    component [Vehicle Service\n(Port: 8082)] as VehicleService
    component [Reservation Service\n(Port: 8083)] as ReservationService
    component [Payment Service\n(Port: 8084)] as PaymentService
    component [Agency Service\n(Port: 8085)] as AgencyService
    component [Review Service\n(Port: 8086)] as ReviewService
}

database "MySQL 8.0\n(user_db)" as DB_User
database "MySQL 8.0\n(vehicle_db)" as DB_Vehicle
database "MySQL 8.0\n(reservation_db)" as DB_Res
database "MySQL 8.0\n(payment_db)" as DB_Pay
database "MySQL 8.0\n(agency_db)" as DB_Agency
database "MySQL 8.0\n(review_db)" as DB_Review

user --> Frontend : HTTPS / UI
Frontend --> Gateway : REST / JSON / JWT (Bearer)

Gateway ..> Eureka : Découverte de services
UserService ..> Eureka : Enregistrement
VehicleService ..> Eureka : Enregistrement
ReservationService ..> Eureka : Enregistrement
PaymentService ..> Eureka : Enregistrement
AgencyService ..> Eureka : Enregistrement
ReviewService ..> Eureka : Enregistrement

Gateway --> UserService : /api/users/**
Gateway --> VehicleService : /api/vehicles/**
Gateway --> ReservationService : /api/reservations/**
Gateway --> PaymentService : /api/payments/**
Gateway --> AgencyService : /api/agencies/**
Gateway --> ReviewService : /api/reviews/**

ReservationService --> VehicleService : [Synchrone OpenFeign]\nVérif disponibilité & tarif
ReservationService --> PaymentService : [Synchrone OpenFeign]\nInitialisation transaction
VehicleService --> AgencyService : [Synchrone OpenFeign]\nVérif existence agence

ReservationService ..> RabbitMQ : [Asynchrone]\nreservation.created\nreservation.cancelled
PaymentService ..> RabbitMQ : [Asynchrone]\npayment.completed\npayment.failed
RabbitMQ ..> ReservationService : Consommation événement
RabbitMQ ..> VehicleService : Consommation événement

UserService --> DB_User
VehicleService --> DB_Vehicle
ReservationService --> DB_Res
PaymentService --> DB_Pay
AgencyService --> DB_Agency
ReviewService --> DB_Review

@enduml
