@startuml Classes_Payment_Service
!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "com.carrental.payment.domain" {
    enum PaymentStatus {
        PENDING
        PAID
        FAILED
        REFUNDED
    }

    enum PaymentMethod {
        CREDIT_CARD
        PAYPAL
        CASH_ON_PICKUP
    }

    class Payment {
        - id: Long
        - transactionId: String
        - reservationId: Long
        - userId: Long
        - amount: BigDecimal
        - currency: String
        - paymentMethod: PaymentMethod
        - status: PaymentStatus
        - paymentDate: LocalDateTime
        - errorMessage: String
    }

    class Invoice {
        - id: Long
        - invoiceNumber: String
        - paymentId: Long
        - reservationId: Long
        - customerName: String
        - totalAmount: BigDecimal
        - taxAmount: BigDecimal
        - issuedAt: LocalDateTime
        - pdfUrl: String
    }

    Payment "1" -- "0..1" Invoice : génère >
    Payment --> PaymentStatus
    Payment --> PaymentMethod
}

package "com.carrental.payment.dto" {
    class PaymentRequest {
        + reservationId: Long
        + userId: Long
        + amount: BigDecimal
        + method: PaymentMethod
        + cardNumber: String
        + cardExpiry: String
        + cvv: String
    }

    class PaymentResponse {
        + id: Long
        + transactionId: String
        + reservationId: Long
        + amount: BigDecimal
        + status: PaymentStatus
        + paymentDate: LocalDateTime
        + invoiceNumber: String
    }

    class InvoiceDTO {
        + invoiceNumber: String
        + reservationId: Long
        + totalAmount: BigDecimal
        + issuedAt: LocalDateTime
    }
}

package "com.carrental.payment.repository" {
    interface PaymentRepository {
        + findByReservationId(reservationId: Long): Optional<Payment>
        + findByTransactionId(txId: String): Optional<Payment>
        + findByUserId(userId: Long): List<Payment>
    }

    interface InvoiceRepository {
        + findByReservationId(reservationId: Long): Optional<Invoice>
        + findByPaymentId(paymentId: Long): Optional<Invoice>
    }
}

package "com.carrental.payment.service" {
    interface PaymentService {
        + processPayment(req: PaymentRequest): PaymentResponse
        + getPaymentById(id: Long): PaymentResponse
        + getPaymentByReservation(resId: Long): PaymentResponse
        + refundPayment(id: Long): PaymentResponse
        + generateInvoice(paymentId: Long): InvoiceDTO
    }
}

package "com.carrental.payment.controller" {
    class PaymentController {
        - paymentService: PaymentService
        + process(req: PaymentRequest): ResponseEntity<PaymentResponse>
        + getById(id: Long): ResponseEntity<PaymentResponse>
        + getByReservation(resId: Long): ResponseEntity<PaymentResponse>
        + refund(id: Long): ResponseEntity<PaymentResponse>
        + getInvoice(id: Long): ResponseEntity<InvoiceDTO>
    }
}

PaymentController --> PaymentService
PaymentService ..> PaymentRepository
PaymentService ..> InvoiceRepository
PaymentRepository --> Payment
InvoiceRepository --> Invoice

@enduml
