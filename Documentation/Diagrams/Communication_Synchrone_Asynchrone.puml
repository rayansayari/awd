@startuml Communication_Synchrone_Asynchrone
!theme plain
skinparam componentStyle uml2
skinparam packageStyle rectangle

title Modèle de Communication Inter-Microservices : Synchrone vs Asynchrone

package "Communications Synchrones (REST / Spring Cloud OpenFeign)" {
    [Reservation Service] as RS_Sync
    [Vehicle Service] as VS_Sync
    [Payment Service] as PS_Sync
    [Agency Service] as AS_Sync

    RS_Sync --> VS_Sync : 1. GET /api/vehicles/{id}/availability\n(Bloquant, Temps réel requis)
    RS_Sync --> PS_Sync : 2. POST /api/payments/process\n(Bloquant, Résultat immédiat exigé)
    VS_Sync --> AS_Sync : 3. GET /api/agencies/{id}\n(Vérification d'existence agence)
    note bottom of RS_Sync
      **Usage du Synchrone :**
      - Dépendance immédiate pour continuer le traitement métier
      - Requête / Réponse HTTP point-à-point avec Spring Cloud OpenFeign
      - Résilience gérée par Circuit Breaker (Resilience4j)
    end note
}

package "Communications Asynchrones (Event-Driven avec RabbitMQ)" {
    [Reservation Service] as RS_Async
    [Payment Service] as PS_Async
    queue "Exchange: carrental.topic\nBroker: RabbitMQ" as Exchange
    queue "Queue: vehicle.reservation.queue" as Q_Veh
    queue "Queue: notification.queue" as Q_Notif
    [Vehicle Service] as VS_Async
    [Notification / Audit] as Notif_Async

    RS_Async ..> Exchange : Publie "reservation.confirmed"\n(Non-bloquant, Découplé)
    PS_Async ..> Exchange : Publie "payment.completed"\n(Non-bloquant)
    Exchange --> Q_Veh : Binding: *.confirmed
    Exchange --> Q_Notif : Binding: *.*
    Q_Veh ..> VS_Async : Consomme & met à jour statut véhicule
    Q_Notif ..> Notif_Async : Consomme pour email/historique

    note bottom of Exchange
      **Usage de l'Asynchrone :**
      - Traitements secondaires (mise à jour d'état, notifications, audit)
      - Aucun blocage du thread appelant
      - Haute disponibilité : si le récepteur est temporairement indisponible,
        le message reste stocké dans la file d'attente RabbitMQ
    end note
}

@enduml
